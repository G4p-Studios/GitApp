{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "node"],
    // Resolve `react-native` to the Windows type surface. RNW re-exports all
    // of core plus the Windows-only props this app depends on: onKeyDown,
    // keyDownEvents, tabIndex, accessibilityPosInSet, accessibilitySetSize,
    // accessibilityLevel, accessibilityDescription, accessibilityAccessKey,
    // and the pane / listitem / statusbar accessibility roles.
    //
    // Without this mapping every accessibility prop in src/a11y is a type
    // error, which is a good early warning that the file is being compiled
    // against the wrong platform.
    "paths": {
      "react-native": ["./node_modules/react-native-windows"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "**/windows"]
}
