{
  "name": "gitapp",
  "version": "0.0.1",
  "private": true,
  "description": "A screen-reader-first Git and GitHub client for Windows.",
  "license": "MIT",
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "start": "react-native start",
    "windows": "npx @react-native-community/cli run-windows",
    "windows:release": "react-native run-windows --release",
    "autolink-windows": "react-native autolink-windows",
    "codegen-windows": "react-native codegen-windows",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:a11y": "jest tests/a11y",
    "test:a11y:update": "jest tests/a11y -u",
    "test:windows": "jest --config jest.config.windows.js"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-windows": "0.84.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/eslint-config": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "@rnx-kit/jest-preset": "^0.3.1"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "gitapp",
      "namespace": "gitapp",
      "template": "cpp-app"
    }
  }
}
