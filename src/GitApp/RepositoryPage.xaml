<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:a11y="clr-namespace:GitApp.Accessibility"
             xmlns:vm="clr-namespace:GitApp.ViewModels"
             xmlns:domain="clr-namespace:GitApp.Domain"
             xmlns:local="clr-namespace:GitApp"
             x:Class="GitApp.RepositoryPage"
             x:DataType="vm:RepositoryViewModel"
             Title="Repository">

    <!--
      Three panes, cycled with F6: Files, Readme, About.

      Laid out the way github.com lays out a repository: the file table in
      the main column with the README under it, and About as the sidebar
      on the right. The latest commit sits at the foot of Files, between
      the table and the README. It is one fact, and a pane the user cycles
      through to hear one sentence is friction. See docs/REPOSITORY-VIEW.md.
    -->

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,300">

        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2"
                               Padding="12,8" Spacing="8">
            <Button x:Name="BackButton"
                    Text="Back to GitHub"
                    Clicked="OnBack"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Returns to your GitHub repositories. Escape does the same at the repository root." />
            <Button Text="Clone"
                    x:Name="CloneButton"
                    Command="{Binding CloneCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Clones this repository onto this computer" />
            <Button Text="View on github.com"
                    x:Name="OpenGitHubButton"
                    Command="{Binding OpenOnGitHubCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Opens this repository in your browser" />
            <Button Text="Issues"
                    x:Name="IssuesButton"
                    Clicked="OnOpenIssues"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Lists issues in this repository" />
            <Button Text="Pull requests"
                    x:Name="PullsButton"
                    Clicked="OnOpenPulls"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Lists pull requests in this repository" />
        </HorizontalStackLayout>

        <!-- Main column: files, then the latest commit, then the README -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,*">

        <!-- Files -->
        <a11y:Pane x:Name="FilesPane"
                   Grid.Row="0"
                   PaneId="repo-files" PaneName="Files" PaneOrder="10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="12" RowSpacing="4">

                <Label Grid.Row="0"
                       Text="{Binding Title}"
                       FontSize="20"
                       SemanticProperties.HeadingLevel="Level1" />

                <Picker Grid.Row="1"
                        x:Name="BranchPicker"
                        ItemsSource="{Binding Branches}"
                        SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding AccessibleName}"
                        Title="Branch"
                        SemanticProperties.Description="Current branch"
                        SemanticProperties.Hint="Choosing a branch shows that branch's files" />

                <Label Grid.Row="2"
                       IsVisible="{Binding HasPath}"
                       Text="{Binding PathDescription}"
                       FontSize="13"
                       Opacity="0.8"
                       SemanticProperties.Description="{Binding PathDescription, StringFormat='Current folder, {0}'}" />

                <Label Grid.Row="3"
                       Text="{Binding EntrySummary}"
                       FontSize="13"
                       Opacity="0.8"
                       Margin="0,0,0,4"
                       SemanticProperties.HeadingLevel="Level2" />

                <CollectionView Grid.Row="4"
                                x:Name="FileList"
                                ItemsSource="{Binding Entries}"
                                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                SelectionMode="Single"
                                SemanticProperties.Description="Files. Enter opens a folder or a file, Left goes up one folder.">
                    <CollectionView.EmptyView>
                        <Label Text="This folder is empty"
                               Padding="8" FontSize="13" Opacity="0.7" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="domain:GitHubTreeEntry">
                            <VerticalStackLayout Padding="8,6"
                                                 SemanticProperties.Description="{Binding AccessibleName}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenEntryCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="14" />
                                <Label Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--
                  The latest commit on the branch: subject, then author,
                  age and hash, as github.com shows it. One spoken name for
                  the pair, content first (ARCHITECTURE 3.3).
                -->
                <VerticalStackLayout Grid.Row="5"
                                     IsVisible="{Binding HasLatest}"
                                     Margin="0,8,0,0"
                                     Padding="8,6"
                                     SemanticProperties.Description="{Binding LatestSummary}">
                    <Label Text="{Binding LatestSubject}" FontSize="14" />
                    <Label Text="{Binding LatestDetail}" FontSize="12" Opacity="0.7" />
                </VerticalStackLayout>
            </Grid>
        </a11y:Pane>

        <!-- Readme -->
        <a11y:Pane x:Name="ReadmePane"
                   Grid.Row="1"
                   PaneId="repo-readme" PaneName="Readme" PaneOrder="20">
            <Grid Padding="12">
                <VerticalStackLayout x:Name="ReadmeEmptyHost"
                                     Spacing="8"
                                     IsVisible="{Binding NoReadme}">
                    <Label x:Name="ReadmeHeadingLabel"
                           Text="{Binding ReadmeHeading}"
                           FontSize="16"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="ReadmeEmptyLabel"
                           Text="{Binding ReadmeEmpty}"
                           FontSize="14"
                           Opacity="0.7" />
                </VerticalStackLayout>

                <local:MarkdownDocumentView x:Name="ReadmeDocument"
                                            FillPane="True"
                                            ShowTitleInDocument="True"
                                            IsVisible="{Binding HasReadme}" />
            </Grid>
        </a11y:Pane>

        </Grid>

        <!-- About: the github.com sidebar -->
        <a11y:Pane x:Name="AboutPane"
                   Grid.Row="1" Grid.Column="1"
                   PaneId="repo-about" PaneName="About" PaneOrder="30">
            <ScrollView Padding="12">
                <VerticalStackLayout x:Name="AboutContent" Spacing="8">
                    <Label x:Name="AboutHeading"
                           Text="About"
                           FontSize="16"
                           SemanticProperties.HeadingLevel="Level1" />
                    <VerticalStackLayout x:Name="AboutFactsHost" Spacing="8" />
                </VerticalStackLayout>
            </ScrollView>
        </a11y:Pane>

        <Label x:Name="StatusLabel"
               Grid.Row="2" Grid.ColumnSpan="2"
               Padding="12,6" FontSize="14" Opacity="0.7" Text=""
               SemanticProperties.Description="Status" />
    </Grid>
</ContentPage>
