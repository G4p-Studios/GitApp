<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:a11y="clr-namespace:GitApp.Accessibility"
             xmlns:vm="clr-namespace:GitApp.ViewModels"
             x:Class="GitApp.WorkDetailPage"
             x:DataType="vm:WorkDetailViewModel"
             Title="Conversation">

    <!--
      Three panes, cycled with F6: Conversation, Comment, About.

      The conversation is a document, not a list: the title is a heading,
      each comment is a heading, and the bodies are rendered Markdown so
      a screen reader can jump by heading. The comment box sits under it,
      where github.com puts it. See docs/ISSUES.md.
    -->

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,280">

        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2"
                               Padding="12,8" Spacing="8">
            <Button x:Name="BackButton"
                    Text="Back to list"
                    Clicked="OnBack"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Returns to the list. Escape does the same." />
            <Button Text="View on github.com"
                    Command="{Binding OpenOnGitHubCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Opens this conversation in your browser" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto">

        <a11y:Pane x:Name="ConversationPane"
                   Grid.Row="0"
                   PaneId="work-conversation" PaneName="Conversation" PaneOrder="10">
            <ScrollView Padding="12">
                <VerticalStackLayout x:Name="ConversationContent" Spacing="10">
                    <Label x:Name="TitleLabel"
                           Text="{Binding Title}"
                           FontSize="22"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Metadata}"
                           FontSize="14"
                           Opacity="0.8"
                           SemanticProperties.Description="{Binding Metadata}" />
                    <VerticalStackLayout x:Name="BodyHost" Spacing="8" />
                    <Label x:Name="CommentsHeadingLabel"
                           Text="{Binding CommentsHeading}"
                           FontSize="16"
                           Margin="0,12,0,0"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout x:Name="CommentsHost" Spacing="12" />
                </VerticalStackLayout>
            </ScrollView>
        </a11y:Pane>

        <!--
          Writing a comment. Its own pane so F6 reaches the editor
          directly instead of arrowing to the end of a long conversation.
          Order 15: between the conversation and About, the same top-to-
          bottom order as the web page.
        -->
        <a11y:Pane x:Name="CommentPane"
                   Grid.Row="1"
                   PaneId="work-comment" PaneName="Comment" PaneOrder="15">
            <Grid RowDefinitions="Auto,Auto,Auto" Padding="12" RowSpacing="6">
                <Label Grid.Row="0"
                       x:Name="CommentHeading"
                       Text="Add a comment"
                       FontSize="16"
                       SemanticProperties.HeadingLevel="Level2" />

                <Editor Grid.Row="1"
                        x:Name="CommentEditor"
                        Text="{Binding Draft, Mode=TwoWay}"
                        HeightRequest="96"
                        AutoSize="Disabled"
                        Placeholder="Write in Markdown"
                        SemanticProperties.Description="Comment"
                        SemanticProperties.Hint="Markdown. Control Enter posts." />

                <Button Grid.Row="2"
                        Text="Post comment"
                        Command="{Binding PostCommentCommand}"
                        HorizontalOptions="Start"
                        MinimumHeightRequest="32"
                        SemanticProperties.Hint="Control Enter in the comment does the same" />
            </Grid>
        </a11y:Pane>

        </Grid>

        <a11y:Pane x:Name="AboutPane"
                   Grid.Row="1" Grid.Column="1"
                   PaneId="work-about" PaneName="About" PaneOrder="20">
            <ScrollView Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="AboutHeading"
                           Text="About"
                           FontSize="16"
                           SemanticProperties.HeadingLevel="Level1" />
                    <VerticalStackLayout x:Name="AboutFactsHost" Spacing="8" />
                </VerticalStackLayout>
            </ScrollView>
        </a11y:Pane>

        <Label x:Name="StatusLabel"
               Grid.Row="2" Grid.ColumnSpan="2"
               Padding="12,6" FontSize="14" Opacity="0.7" Text=""
               SemanticProperties.Description="Status" />
    </Grid>
</ContentPage>
