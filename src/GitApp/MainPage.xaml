<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:a11y="clr-namespace:GitApp.Accessibility"
             xmlns:vm="clr-namespace:GitApp.ViewModels"
             xmlns:domain="clr-namespace:GitApp.Domain"
             x:Class="GitApp.MainPage"
             x:DataType="vm:MainViewModel"
             Title="GitApp">

    <!--
      Four panes, cycled with F6: Repositories, Changes, Commit, History.

      Every list gives its rows a single accessible name in reading order,
      because a row is announced as one label. Every action that can outlast
      a second announces its start and its result. No literal colours; MAUI
      follows the system theme.
    -->

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="300,*,320">

        <!-- Toolbar spanning the top -->
        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="3"
                               Padding="12,8" Spacing="8">
            <Button Text="Add repository"
                    Command="{Binding AddRepositoryCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Choose a folder containing a Git repository" />
            <Button Text="Clone"
                    Command="{Binding CloneCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Clone a repository from a URL into a folder you choose" />
            <Button Text="Remove"
                    Command="{Binding RemoveRepositoryCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Removes the repository from this list. The folder on disk is not deleted." />
            <Button Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    MinimumHeightRequest="32" />
            <BoxView WidthRequest="1" Margin="4,0" />
            <Button Text="Fetch"
                    Command="{Binding FetchCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Downloads new commits without changing your working tree" />
            <Button Text="Pull"
                    Command="{Binding PullCommand}"
                    MinimumHeightRequest="32"
                    SemanticProperties.Hint="Fast-forward only" />
            <Button Text="Push"
                    Command="{Binding PushCommand}"
                    MinimumHeightRequest="32" />
        </HorizontalStackLayout>

        <!-- Repositories -->
        <a11y:Pane x:Name="ReposPane"
                   Grid.Row="1" Grid.Column="0"
                   PaneId="repos" PaneName="Repositories" PaneOrder="10">
            <VerticalStackLayout Padding="8">
                <Label Text="Repositories" FontSize="12" Opacity="0.7"
                       Margin="4,0,0,4"
                       SemanticProperties.HeadingLevel="Level2" />

                <CollectionView x:Name="RepoList"
                                ItemsSource="{Binding Repositories}"
                                SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                                SelectionMode="Single"
                                SemanticProperties.Description="Repositories">
                    <CollectionView.EmptyView>
                        <Label Text="No repositories yet. Use Add repository to get started."
                               Padding="12" FontSize="14" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryItem">
                            <VerticalStackLayout Padding="8,4"
                                                 SemanticProperties.Description="{Binding AccessibleName}">
                                <Label Text="{Binding Name}" FontSize="14" />
                                <Label Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </a11y:Pane>

        <!-- Changes -->
        <a11y:Pane x:Name="ChangesPane"
                   Grid.Row="1" Grid.Column="1"
                   PaneId="changes" PaneName="Changes" PaneOrder="20">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*" Padding="12">

                <Label Grid.Row="0" Text="{Binding RepositoryTitle}"
                       FontSize="20" SemanticProperties.HeadingLevel="Level1" />

                <Label Grid.Row="1" Text="{Binding BranchSummary}"
                       FontSize="14" Opacity="0.7" Margin="0,0,0,12" />

                <!--
                  Conflicts, shown only during a merge. First in the pane
                  because nothing else in the repository can proceed until
                  they are dealt with.
                -->
                <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsMerging}" Margin="0,0,0,12">
                    <HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
                        <Label Text="{Binding MergeSummary}" FontSize="14"
                               VerticalOptions="Center"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Button Text="Abort merge"
                                Command="{Binding AbortMergeCommand}"
                                FontSize="12" Padding="8,0" MinimumHeightRequest="28"
                                SemanticProperties.Hint="Throws away the merge and any resolution done so far" />
                    </HorizontalStackLayout>

                    <CollectionView x:Name="ConflictList"
                                    ItemsSource="{Binding Conflicts}"
                                    SelectionMode="Single"
                                    SemanticProperties.Description="Conflicted files">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:FileChange">
                                <VerticalStackLayout Padding="8,4"
                                                     SemanticProperties.Description="{Binding AccessibleName}">
                                    <Label Text="{Binding FileName}" FontSize="14" />
                                    <Label Text="{Binding Directory}" FontSize="12" Opacity="0.7" />
                                    <!--
                                      Each side is named by its branch. "Ours"
                                      and "theirs" are ambiguous even to people
                                      who use git every day, and worse when
                                      heard rather than read.
                                    -->
                                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                        <Button Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.KeepOursLabel}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.KeepOursCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="12" Padding="8,0" MinimumHeightRequest="28" />
                                        <Button Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.KeepTheirsLabel}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.KeepTheirsCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="12" Padding="8,0" MinimumHeightRequest="28" />
                                        <Button Text="Mark resolved"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkResolvedCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="12" Padding="8,0" MinimumHeightRequest="28"
                                                SemanticProperties.Hint="Use after editing the file yourself" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3">
                    <HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
                        <Label Text="Unstaged" FontSize="12" Opacity="0.7"
                               VerticalOptions="Center"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Button Text="Stage all"
                                Command="{Binding StageAllCommand}"
                                FontSize="12" Padding="8,0" MinimumHeightRequest="28" />
                    </HorizontalStackLayout>

                    <CollectionView x:Name="UnstagedList"
                                    ItemsSource="{Binding Unstaged}"
                                    SelectionMode="Single"
                                    SemanticProperties.Description="Unstaged changes">
                        <CollectionView.EmptyView>
                            <Label Text="Nothing unstaged" Padding="8" FontSize="13" Opacity="0.7" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:FileChange">
                                <Grid ColumnDefinitions="*,Auto" Padding="8,4"
                                      SemanticProperties.Description="{Binding AccessibleName}">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding FileName}" FontSize="14" />
                                        <Label Text="{Binding StateDescription}" FontSize="12" Opacity="0.7" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Stage"
                                            FontSize="12" Padding="8,0" MinimumHeightRequest="28"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StageCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{Binding FileName, StringFormat='Stage {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Label Grid.Row="4" Text="Staged" FontSize="12" Opacity="0.7"
                       Margin="0,12,0,4"
                       SemanticProperties.HeadingLevel="Level2" />

                <CollectionView Grid.Row="5"
                                x:Name="StagedList"
                                ItemsSource="{Binding Staged}"
                                SelectionMode="Single"
                                SemanticProperties.Description="Staged changes">
                    <CollectionView.EmptyView>
                        <Label Text="Nothing staged" Padding="8" FontSize="13" Opacity="0.7" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="domain:FileChange">
                            <Grid ColumnDefinitions="*,Auto" Padding="8,4"
                                  SemanticProperties.Description="{Binding AccessibleName}">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding FileName}" FontSize="14" />
                                    <Label Text="{Binding StateDescription}" FontSize="12" Opacity="0.7" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Unstage"
                                        FontSize="12" Padding="8,0" MinimumHeightRequest="28"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UnstageCommand}"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="{Binding FileName, StringFormat='Unstage {0}'}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </a11y:Pane>

        <!-- Commit, branches and history -->
        <a11y:Pane x:Name="CommitPane"
                   Grid.Row="1" Grid.Column="2"
                   PaneId="commit" PaneName="Commit" PaneOrder="30">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="12">

                <Label Grid.Row="0" Text="Commit message" FontSize="12" Opacity="0.7"
                       Margin="0,0,0,4"
                       SemanticProperties.HeadingLevel="Level2" />

                <Editor Grid.Row="1"
                        x:Name="CommitMessageEditor"
                        Text="{Binding CommitMessage, Mode=TwoWay}"
                        HeightRequest="90"
                        AutoSize="Disabled"
                        SemanticProperties.Description="Commit message"
                        SemanticProperties.Hint="Describe what changed and why" />

                <Button Grid.Row="2" Text="Commit"
                        Command="{Binding CommitCommand}"
                        Margin="0,8,0,0"
                        MinimumHeightRequest="32"
                        SemanticProperties.Hint="Commits the staged changes" />

                <HorizontalStackLayout Grid.Row="3" Spacing="8" Margin="0,16,0,4">
                    <Label Text="Branches" FontSize="12" Opacity="0.7"
                           VerticalOptions="Center"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Button Text="New branch"
                            Command="{Binding CreateBranchCommand}"
                            FontSize="12" Padding="8,0" MinimumHeightRequest="28" />
                </HorizontalStackLayout>

                <!--
                  A picker rather than a list: it is a single choice, it
                  reports the current value without the user having to hunt
                  for it, and it is one tab stop instead of one per branch.
                -->
                <Picker Grid.Row="4"
                        x:Name="BranchPicker"
                        ItemsSource="{Binding Branches}"
                        SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding AccessibleName}"
                        Title="Switch branch"
                        SemanticProperties.Description="Current branch"
                        SemanticProperties.Hint="Choosing a branch switches to it" />

                <Label Grid.Row="5" Text="History" FontSize="12" Opacity="0.7"
                       Margin="0,16,0,4"
                       SemanticProperties.HeadingLevel="Level2" />

                <CollectionView Grid.Row="6"
                                x:Name="HistoryList"
                                ItemsSource="{Binding Commits}"
                                SelectionMode="Single"
                                SemanticProperties.Description="Recent commits">
                    <CollectionView.EmptyView>
                        <Label Text="No commits" Padding="8" FontSize="13" Opacity="0.7" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="domain:CommitInfo">
                            <VerticalStackLayout Padding="8,4"
                                                 SemanticProperties.Description="{Binding AccessibleName}">
                                <Label Text="{Binding Subject}" FontSize="14" />
                                <Label Text="{Binding Detail}" FontSize="12" Opacity="0.7" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </a11y:Pane>

        <!--
          The application status line. One live region for the whole app:
          multiple simultaneous regions race in the speech queue and the user
          hears fragments. See docs/ARCHITECTURE.md 3.5.
        -->
        <Label x:Name="StatusLabel"
               Grid.Row="2" Grid.ColumnSpan="3"
               Padding="12,6" FontSize="14" Opacity="0.7" Text=""
               SemanticProperties.Description="Status" />
    </Grid>
</ContentPage>
