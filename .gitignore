# ---------------------------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/cache
.yarn/install-state.gz

# ---------------------------------------------------------------------------
# Metro / React Native
# ---------------------------------------------------------------------------
.metro-health-check*
metro.config.js.bak
*.jsbundle
*.bundle.map
.expo/

# ---------------------------------------------------------------------------
# React Native Windows: generated code and build output
#
# Codegen output is regenerated by `npx react-native codegen-windows` and the
# autolinking step, so it must not be tracked. windows/.vs holds per-developer
# Visual Studio state.
# ---------------------------------------------------------------------------
windows/**/Generated Files/
windows/**/AutolinkedNativeModules.g.*
windows/**/*.g.cpp
windows/**/*.g.h
windows/.vs/
windows/packages/
windows/**/bin/
windows/**/obj/
windows/**/Debug/
windows/**/Release/
windows/**/ARM64/
windows/**/x64/
windows/**/x86/
windows/**/AppPackages/
windows/**/BundleArtifacts/
windows/**/_ReSharper*/
windows/msbuild.binlog
windows/**/*.appx
windows/**/*.appxbundle
windows/**/*.msix
windows/**/*.msixbundle
windows/**/*.pfx
windows/**/*.cer

# ---------------------------------------------------------------------------
# Visual Studio / MSBuild
# ---------------------------------------------------------------------------
*.user
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opendb
*.ipch
*.aps
*.ncb
*.sdf
*.cachefile
*.pdb
*.idb
*.ilk
*.tlog
*.log
*.lastbuildstate
*.unsuccessfulbuild
ipch/
.vs/

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
.jest-cache/
test-results/
*.trx

# UIA tree snapshots are the accessibility contract (docs/ARCHITECTURE.md 3.7)
# and ARE tracked. Only the failure diffs written beside them are ignored.
tests/**/__snapshots__/*.snap.new
tests/**/__diff_output__/

# ---------------------------------------------------------------------------
# Local configuration and secrets
#
# GitHub tokens belong in Windows Credential Manager, never on disk
# (docs/ARCHITECTURE.md 4.5). These entries are a backstop, not the mechanism.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
secrets.json

# ---------------------------------------------------------------------------
# Bundled portable Git (docs/ARCHITECTURE.md 4.2)
# Fetched by a setup script rather than committed.
# ---------------------------------------------------------------------------
vendor/git/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
