# Normalize line endings so the C++/WinRT and JS halves of the tree agree.
* text=auto eol=lf

# Windows-native project files that Visual Studio rewrites with CRLF.
*.sln            text eol=crlf
*.vcxproj        text eol=crlf
*.vcxproj.filters text eol=crlf
*.props          text eol=crlf
*.targets        text eol=crlf
*.cmd            text eol=crlf
*.bat            text eol=crlf
*.ps1            text eol=crlf

# Binary assets.
*.png    binary
*.jpg    binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff2  binary
*.pfx    binary
*.appx   binary
*.msix   binary

# UIA snapshots are reviewed as text diffs; keep them stable across machines.
*.snap   text eol=lf
