# Normalize line endings across the C# and XAML tree.
* text=auto eol=lf

# Files Visual Studio rewrites with CRLF.
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary assets.
*.png    binary
*.jpg    binary
*.svg    text
*.ico    binary
*.ttf    binary
*.otf    binary
*.pfx    binary
*.appx   binary
*.msix   binary
